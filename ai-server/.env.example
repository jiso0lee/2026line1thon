# .env로 복사 후 값 입력, .env는 git에 올리지 않음

# [필수] OpenAI API 키, 없으면 질문은 기본 질문·리포트는 503 응답
OPENAI_API_KEY=

# 사용할 모델 (예: gpt-5.4-mini, gpt-5.6-luna, gpt-5.4-nano)
OPENAI_MODEL=gpt-5.4-mini
# 추론 강도, 빈 값이면 미전송 (모델 미지원 오류가 나면 비워 둠)
OPENAI_REASONING_EFFORT=low

# 요청 1건의 전체 시간 예산(초), 재시도 포함, BE 타임아웃은 이보다 2~3초 길게
QUESTION_TIMEOUT_SECONDS=12
REPORT_TIMEOUT_SECONDS=25
# LLM 호출 최대 횟수 (첫 시도 + 재시도)
LLM_MAX_ATTEMPTS=2

# 값이 있으면 BE가 X-API-Key 헤더로 이 값 전송 필요
AI_API_KEY=

# 일기 수가 이보다 적으면 장기적인 변화 판단이 어렵다고 안내
FEW_RECORDS_THRESHOLD=7

LOG_LEVEL=INFO
